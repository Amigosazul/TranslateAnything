{
  "hotkey": "Alt+T",
  "target_lang": "zh-CN",
  "mode": "ocr",
  "ocr_lang": "auto",
  "engine": "edge",
  "fallback": ["bing", "google_free"],
  "persist_cache": true,
  "builtin_glossary": true,
  "glossary": {
    "Opus": "Opus",
    "Artifacts": "工件"
  },
  "immersive": {
    "enabled": true,
    "hotkey": "Alt+Shift+T",
