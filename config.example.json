      {
        "name": "reclaude 客户端",
        "enabled": true,
        "exe": "C:\\Users\\你的用户名\\.rec\\claude-app\\app\\claude.exe",
        "args": "",
        "port": 39222,
        "url_prefixes": [],
        "skip_selectors": []
      }
    ]
  },
  "engines": {
    "edge": {},
    "bing": {},
    "google_free": {
      "proxy": "http://127.0.0.1:7897"
    },
    "microsoft": {
      "api_key": "在此填写你的 key",
      "region": "eastasia"
    },
    "deepl": {
      "api_key": "在此填写你的 key"
    },
    "deeplx": {
      "base_url": "http://127.0.0.1:1188/translate"
    },
    "openai": {
      "base_url": "https://api.example.com/v1",
      "api_key": "在此填写你的 key",
      "model": "gpt-4o-mini"
    }
  }
}
